rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'pedrao141414@gmail.com'
      );
    }

    // Test connection document for startup validation
    match /test/{docId} {
      allow read, write: if true;
    }

    // System Backups & Cloud Snapshots
    match /system_backups/{backupId} {
      allow read, write: if true;
    }

    // Company Settings
    match /company_settings/{settingId} {
      allow read, write: if true;
    }

    // Users
    match /users/{userId} {
      allow read, write: if true;
    }

    // Employees
    match /employees/{employeeId} {
      allow read, write: if true;
    }

    // Contracts
    match /contracts/{contractId} {
      allow read, write: if true;
    }

    // Documents
    match /documents/{documentId} {
      allow read, write: if true;
    }

    // Payroll Sheets
    match /payroll_sheets/{sheetId} {
      allow read, write: if true;
    }
  }
}
